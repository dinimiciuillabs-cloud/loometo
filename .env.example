# Loometo environment — copy to .env.local and fill in what you have.
# .env.local is gitignored. NEVER commit real keys.
#
# THIS FILE IS OPTIONAL. The easiest setup is pasting keys in the app:
# Setup Keys (top right) → paste → Save. Done, no restart.
# Use this file instead if you want keys in config (e.g. shared dev
# machines, scripted setups). Keys set here override pasted ones.
#
# Only MUAPI_API_KEY is required — it unlocks ~80% of Loometo (video, 3D,
# upscale, image edit, and more through one reseller key). Everything else
# is optional. Restart the dev server after editing (Next.js doesn't
# hot-reload env vars).

# ── Required ────────────────────────────────────────────────────────────
# One key, hundreds of models (Kling, Veo, Wan, Sora, Flux, Tripo, …).
# Get it: https://muapi.ai
MUAPI_API_KEY=

# ── Optional: direct provider routes (bypass the reseller for raw cost) ──
# Google Gemini/Imagen/Veo direct. Get it: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# ElevenLabs TTS + voice cloning. Get it: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ── Optional: asset hosting (Cloudflare R2) ─────────────────────────────
# Model providers return URLs that expire in 24-72h. Set these to copy
# every generated asset to YOUR bucket for permanent hosting.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Note ────────────────────────────────────────────────────────────────
# OpenAI, Meshy, and Figma keys are entered in the app itself
# (Settings → API Keys), stored in your browser — not here.
